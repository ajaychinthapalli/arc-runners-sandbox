# Copy to .env (git-ignored) and `source .env` before running anything in this repo.
export CLUSTER=ac-ws-dev-use2
export REGION=us-east-2
export ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
export ECR=$ACCOUNT.dkr.ecr.$REGION.amazonaws.com

export ARC_VERSION=0.14.2          # installed on purpose one release behind latest (0.15.0)
export KAGENT_VERSION=0.10.3
export BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6   # sonnet-5-5 was not invokable on this account yet
export HELM_VERSION=$(helm version --short | cut -d+ -f1)   # was v4.2.4
