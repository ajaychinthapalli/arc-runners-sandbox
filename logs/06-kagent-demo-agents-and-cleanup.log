# Cause: the 10 bundled demo agents reference the default provider's API key secret, which was never created.
# The controller CrashLoopBackOff (see log 05) self-healed after 2 restarts once PostgreSQL was ready.

# ---- Fix: disable demo agents with kagent-overrides.yaml ----

bash-5.3$ helm upgrade kagent oci://ghcr.io/kagent-dev/kagent/helm/kagent \
  --namespace kagent --version $KAGENT_VERSION \
  -f kagent-values.yaml -f kagent-overrides.yaml
